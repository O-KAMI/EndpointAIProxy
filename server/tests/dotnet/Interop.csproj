<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Synthetic vector arrays are intentionally constructed in this fixture generator. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>
  <Target Name="CheckOriginal" BeforeTargets="BeforeBuild">
    <Error Condition="'$(OriginalRoot)' == ''" Text="Pass -p:OriginalRoot=/path/to/EndpointAIDLPMVP" />
  </Target>
  <ItemGroup>
    <Compile Include="$(OriginalRoot)/src/Sf.EndpointAI.Contracts/*.cs" Link="Original/Contracts/%(Filename)%(Extension)" />
    <Compile Include="$(OriginalRoot)/src/Sf.EndpointAI.Client.Core/Policy/PolicySignatureVerifier.cs" Link="Original/PolicySignatureVerifier.cs" />
    <Compile Include="$(OriginalRoot)/src/Sf.EndpointAI.Client.Core/Policy/PolicyValidator.cs" Link="Original/PolicyValidator.cs" />
    <Compile Include="$(OriginalRoot)/src/Sf.EndpointAI.Client.Core/Policy/ControlServerCertificateValidator.cs" Link="Original/ControlServerCertificateValidator.cs" />
    <Compile Include="$(OriginalRoot)/src/Sf.EndpointAI.Client.Core/Policy/RemoteControlClient.cs" Link="Original/RemoteControlClient.cs" />
    <Compile Include="$(OriginalRoot)/src/Sf.EndpointAI.Client.Core/Policy/AesControlTransport.cs" Link="Original/AesControlTransport.cs" />
  </ItemGroup>
</Project>
