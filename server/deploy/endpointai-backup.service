[Unit]
Description=EndpointAIDLP consistent MySQL backup
After=network-online.target

[Service]
Type=oneshot
User=endpointai
Group=endpointai
WorkingDirectory=/opt/endpointai/current
Environment=APP_CONFIG=/etc/endpointai/conf
Environment=SF_CONTROL_DATA_ROOT=/var/lib/endpointai
Environment=SF_CONTROL_LOG_DIR=/var/log/endpointai
EnvironmentFile=/etc/endpointai/secrets.env
ExecStart=/opt/endpointai/venv/bin/python manage.py backup --env prd
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/endpointai /var/log/endpointai
StandardOutput=journal
StandardError=journal
