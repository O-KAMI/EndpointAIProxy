# Template only. Replace host and certificate paths; validate with nginx -t before use.
# Client process listens on 127.0.0.1:18080, admin on 127.0.0.1:18081.
# Port 8080 preserves encrypted clients. Both application listeners must be loopback-only.
limit_req_zone $binary_remote_addr zone=endpointai_login:10m rate=5r/m;

server {
    listen 8080;
    location = /api/transport/v1 {
        client_max_body_size 56m;
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / { return 404; }
}

server {
    listen 443 ssl;
    server_name REPLACE_WITH_MANAGEMENT_HOST;
    ssl_certificate /REPLACE_WITH_CERTIFICATE_PATH;
    ssl_certificate_key /REPLACE_WITH_PRIVATE_KEY_PATH;
    location = /api/transport/v1 {
        client_max_body_size 56m;
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location = /admin/v1/rollouts {
        client_max_body_size 8m;
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location ^~ /admin/v1/policy-rollouts {
        client_max_body_size 30m;
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location = /auth/login {
        limit_req zone=endpointai_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
