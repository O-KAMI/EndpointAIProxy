# Set actual values outside the release directory; chmod 0600, owned by the service account.
SF_CONTROL_CLIENT_TOKEN=REPLACE_WITH_RANDOM_ENROLLMENT_TOKEN
SF_CONTROL_ADMIN_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_ADMIN_TOKEN
SF_CONTROL_POLICY_HMAC_KEY=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
# Optional: keep database passwords here instead of mysql_{env}.properties.
# EAI_MYSQL_PASSWORD=REPLACE_LOCALLY
SF_CONTROL_TRANSPORT_KEY_ID=production-2026-01
SF_CONTROL_TRANSPORT_KEY=REPLACE_WITH_BASE64_32_BYTES
# Optional overlap for shared-key rotation; configure both or neither.
# SF_CONTROL_TRANSPORT_ADDITIONAL_KEY_ID=NEXT_KEY_ID
# SF_CONTROL_TRANSPORT_ADDITIONAL_KEY=REPLACE_WITH_DIFFERENT_BASE64_32_BYTES
# Disabled renewal candidate; do not enable before client and isolated deployment acceptance.
# SF_CONTROL_CREDENTIAL_ROTATION=false
