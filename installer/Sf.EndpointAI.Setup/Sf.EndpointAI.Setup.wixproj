<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>EndpointAIDLP-Client-0.1.22-win-x64</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.22</ProductVersion>
    <ServicePublishDir Condition="'$(ServicePublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\publish\service</ServicePublishDir>
    <ProductionInputDir Condition="'$(ProductionInputDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\private-msi-input</ProductionInputDir>
    <InstallerActionsDir Condition="'$(InstallerActionsDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\publish\installer-actions</InstallerActionsDir>
    <DefineConstants>InstallerActionsDir=$(InstallerActionsDir);ProductVersion=$(ProductVersion);ServicePublishDir=$(ServicePublishDir);ProductionInputDir=$(ProductionInputDir)</DefineConstants>
  </PropertyGroup>
  <Target Name="RequirePrivateCredentials" BeforeTargets="Build">
    <Error Condition="!Exists('$(ProductionInputDir)\client-credentials.json')" Text="Run Build-ProductionPackage.ps1 with private client credentials." />
  </Target>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>
</Project>
