<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="顺丰终端 AI 请求代理"
           Manufacturer="SF"
           Version="$(var.ProductVersion)"
           UpgradeCode="643CFDA1-3A12-4C57-BD65-5F6106CBAB90"
           Scope="perMachine"
           Codepage="936"
           InstallerVersion="500">
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="已安装更高版本的顺丰终端 AI 请求代理。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="low" />
    <Property Id="MSIDISABLERMRESTART" Value="1" />
    <Property Id="MsiLogging" Value="voicewarmup!" />
    <Property Id="EndpointAIDLPLogMarker" Value="EndpointAIDLP-Windows-0.1.22" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="SfProgramDirectory" Name="SF">
        <Directory Id="INSTALLFOLDER" Name="Endpoint AI Proxy">
          <Directory Id="DIAGNOSTICSFOLDER" Name="diagnostics" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="SfDataDirectory" Name="SF">
        <Directory Id="DATAFOLDER" Name="EndpointAIProxy" />
      </Directory>
    </StandardDirectory>

    <Component Id="ProxyServiceComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="ProxyServiceExecutable"
            Source="$(var.ServicePublishDir)\Sf.EndpointAI.Client.Service.exe"
            KeyPath="yes" />
      <ServiceInstall Id="ProxyServiceInstall"
                      Name="SfEndpointAIProxy"
                      DisplayName="顺丰终端 AI 请求代理"
                      Description="发现并挂载受支持的 AI Agent，将模型请求经受管路由转发并留痕。"
                      Type="ownProcess"
                      Arguments="--auto-attach=true --route-mode=FixedGateway --gateway-origin=http://gateway.example.invalid --allow-insecure-gateway=true"
                      Start="auto"
                      ErrorControl="normal"
                      Vital="yes" />
      <ServiceControl Id="ProxyServiceControl"
                      Name="SfEndpointAIProxy"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <Component Id="DiagnosticCommandComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="DiagnosticCommandFile"
            Source="$(var.ServicePublishDir)\Collect-Diagnostics.cmd"
            KeyPath="yes" />
      <RemoveFile Id="RemoveLegacyTrayExecutable"
                  Name="Sf.EndpointAI.Client.Tray.exe"
                  On="install" />
      <RemoveRegistryValue Root="HKLM"
                           Key="Software\Microsoft\Windows\CurrentVersion\Run"
                           Name="SF Endpoint AI Proxy Tray" />
    </Component>

    <Component Id="UninstallCommandComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="UninstallCommandFile"
            Source="$(var.ServicePublishDir)\Uninstall-EndpointAI.cmd"
            KeyPath="yes" />
    </Component>

    <Component Id="DiagnosticOutputDirectoryComponent" Directory="DIAGNOSTICSFOLDER" Guid="*">
      <CreateFolder>
        <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
      </CreateFolder>
      <RegistryKey Root="HKLM"
                   Key="Software\SF\EndpointAIProxy"
                   ForceCreateOnInstall="yes">
        <PermissionEx Sddl="D:P(A;;KA;;;SY)(A;;KA;;;BA)" />
        <RegistryValue Name="DiagnosticsDirectoryInstalled"
                       Value="1"
                       Type="integer"
                       KeyPath="yes" />
        <RegistryValue Name="ProductCode"
                       Value="[ProductCode]"
                       Type="string" />
        <RegistryValue Name="DisplayVersion"
                       Value="[ProductVersion]"
                       Type="string" />
      </RegistryKey>
    </Component>

    <Component Id="ProtectedDataDirectoryComponent" Directory="DATAFOLDER" Guid="*">
      <CreateFolder>
        <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
      </CreateFolder>
      <RegistryValue Root="HKLM"
                     Key="Software\SF\EndpointAIProxy"
                     Name="DataDirectoryInstalled"
                     Value="1"
                     Type="integer"
                     KeyPath="yes" />
    </Component>

    <Component Id="ProductionCredentialsComponent" Directory="DATAFOLDER" Guid="*">
      <File Id="ProductionCredentials" Source="$(var.ProductionInputDir)\client-credentials.json" Name="client-credentials.json" KeyPath="yes" />
    </Component>
    <Component Id="ProductionProvisionScriptComponent" Directory="DATAFOLDER" Guid="*">
      <File Id="ProductionProvisionScript" Source="$(var.ProductionInputDir)\Set-ProductionClientControl.ps1" Name="Set-ProductionClientControl.ps1" KeyPath="yes" />
    </Component>
    <Binary Id="InstallerActionsBinary" SourceFile="$(var.InstallerActionsDir)\Sf.EndpointAI.InstallerActions.exe" />
    <CustomAction Id="PreflightLegacy" BinaryRef="InstallerActionsBinary"
      ExeCommand="--mode preflight --install-dir &quot;[INSTALLFOLDER].&quot; --data-dir &quot;[DATAFOLDER].&quot; --transaction &quot;[ProductCode]&quot;"
      Execute="immediate" Return="check" HideTarget="yes" />
    <CustomAction Id="SnapshotConfiguration" BinaryRef="InstallerActionsBinary"
      ExeCommand="--mode snapshot --install-dir &quot;[INSTALLFOLDER].&quot; --data-dir &quot;[DATAFOLDER].&quot; --transaction &quot;[ProductCode]&quot;"
      Execute="immediate" Return="check" HideTarget="yes" />
    <CustomAction Id="RollbackConfiguration" BinaryRef="InstallerActionsBinary"
      ExeCommand="--mode rollback --install-dir &quot;[INSTALLFOLDER].&quot; --data-dir &quot;[DATAFOLDER].&quot; --transaction &quot;[ProductCode]&quot;"
      Execute="rollback" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="QuiesceLegacy" BinaryRef="InstallerActionsBinary"
      ExeCommand="--mode quiesce --install-dir &quot;[INSTALLFOLDER].&quot; --data-dir &quot;[DATAFOLDER].&quot; --transaction &quot;[ProductCode]&quot;"
      Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="ProvisionProductionControl" BinaryRef="InstallerActionsBinary"
      ExeCommand="--mode apply --install-dir &quot;[INSTALLFOLDER].&quot; --data-dir &quot;[DATAFOLDER].&quot; --transaction &quot;[ProductCode]&quot;"
      Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="VerifyInstalledService" BinaryRef="InstallerActionsBinary"
      ExeCommand="--mode verify --install-dir &quot;[INSTALLFOLDER].&quot; --data-dir &quot;[DATAFOLDER].&quot; --transaction &quot;[ProductCode]&quot;"
      Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="CommitConfiguration" BinaryRef="InstallerActionsBinary"
      ExeCommand="--mode commit --install-dir &quot;[INSTALLFOLDER].&quot; --data-dir &quot;[DATAFOLDER].&quot; --transaction &quot;[ProductCode]&quot;"
      Execute="commit" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="DetachManagedConfigurations"
                  FileRef="ProxyServiceExecutable"
                  ExeCommand="--maintenance=detach-all --auto-attach=false"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="PreflightLegacy" Before="InstallValidate" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="SnapshotConfiguration" After="InstallValidate" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RollbackConfiguration" Before="QuiesceLegacy" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="QuiesceLegacy" After="RemoveExistingProducts" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="ProvisionProductionControl" After="InstallServices" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="VerifyInstalledService" After="StartServices" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="CommitConfiguration" After="VerifyInstalledService" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="DetachManagedConfigurations"
              After="StopServices"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Feature Id="Complete" Title="顺丰终端 AI 请求代理" Level="1">
      <ComponentRef Id="ProxyServiceComponent" />
      <ComponentRef Id="ProductionCredentialsComponent" />
      <ComponentRef Id="ProductionProvisionScriptComponent" />
      <ComponentRef Id="ProtectedDataDirectoryComponent" />
      <ComponentRef Id="DiagnosticCommandComponent" />
      <ComponentRef Id="UninstallCommandComponent" />
      <ComponentRef Id="DiagnosticOutputDirectoryComponent" />
    </Feature>
  </Package>
</Wix>
